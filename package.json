{
  "name": "quiet-prs",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Hides bot comments and timeline events on GitHub pull requests.",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/classify.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:serve": "node test/e2e.mjs --serve",
    "icons": "node tools/make-icons.mjs",
    "listing": "node tools/capture-listing.mjs",
    "sign:firefox": "node sign.mjs",
    "publish:chrome": "node publish-chrome.mjs"
  }
}
